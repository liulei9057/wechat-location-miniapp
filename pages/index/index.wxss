.container {
  padding: 24rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef5ff 0%, #f7f9fc 100%);
  min-height: 100vh;
}

.panel {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  box-shadow: 0 12rpx 26rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f1f1f;
}

.status,
.address,
.coords {
  font-size: 28rpx;
  color: #4f5b7a;
  line-height: 1.7;
  word-break: break-all;
}

.action-row {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

button {
  width: 100%;
  border-radius: 12rpx;
}

map {
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.06);
}
